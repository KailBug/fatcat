{
  "name": "fatcat",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript agent harness for native Windows execution.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "pnpm run build && node --env-file-if-exists=.env dist/src/cli.js",
    "test": "pnpm run build && node --test dist/tests/config.test.js"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  }
}
