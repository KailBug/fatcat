{
  "name": "fatcat",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript agent harness for native Windows execution.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "pnpm run check:boundaries && pnpm --filter \"./packages/*\" -r build && tsc --noEmit",
    "build": "pnpm run check:boundaries && pnpm --filter \"./packages/*\" -r build && tsc",
    "start": "pnpm run build && node --env-file-if-exists=.env dist/scripts/start.js",
    "test": "pnpm run build && node packages/verification/dist/scripts/test.js",
    "verify:tui": "pnpm run build && node packages/verification/dist/verify/native/verify-tui.js",
    "verify:cli": "pnpm run build && node packages/verification/dist/verify/native/verify-cli.js",
    "verify:delegation": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-delegation.js",
    "verify:coding": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-coding.js",
    "verify:workflow": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-workflow.js",
    "verify:context": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-context.js",
    "verify:web": "pnpm run build && node packages/verification/dist/verify/network/verify-web.js",
    "verify:browser": "pnpm run build && node packages/verification/dist/verify/browser/verify-browser.js",
    "verify:webui": "pnpm run build && node packages/verification/dist/verify/browser/verify-webui-design.js",
    "verify:webui-models": "pnpm run build && node packages/verification/dist/verify/browser/verify-webui-models.js",
    "verify:sessions": "pnpm run build && node packages/verification/dist/verify/browser/verify-session-workspaces.js",
    "verify:projects": "pnpm run build && node packages/verification/dist/verify/browser/verify-projects.js",
    "verify:project-management": "pnpm run build && node packages/verification/dist/verify/browser/verify-project-management.js",
    "verify:folder-picker": "pnpm run build && node packages/verification/dist/verify/native/verify-folder-picker.js",
    "verify:attachments": "pnpm run build && node packages/verification/dist/verify/browser/verify-attachments.js",
    "verify:documents": "pnpm run build && node packages/verification/dist/verify/browser/verify-documents.js",
    "verify:memory": "pnpm run build && node packages/verification/dist/verify/browser/verify-memory.js",
    "verify:memory:live": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-memory-live.js",
    "verify:live": "pnpm run build && node --env-file-if-exists=.env packages/verification/dist/verify/live/verify-live.js",
    "check:boundaries": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "@fatcat/verification": "workspace:*"
  },
  "dependencies": {
    "@fatcat/runtime": "workspace:*",
    "@fatcat/cli": "workspace:*"
  }
}
