{
  "name": "fatcat",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript agent harness for native Windows execution.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node dist/scripts/copy-skills.js && node dist/scripts/copy-webui.js",
    "start": "pnpm run build && node --env-file-if-exists=.env dist/scripts/start.js",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "verify:delegation": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify-delegation.js",
    "verify:coding": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify-coding.js",
    "verify:workflow": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify-workflow.js",
    "verify:context": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify-context.js",
    "verify:web": "pnpm run build && node dist/scripts/verify-web.js",
    "verify:browser": "pnpm run build && node dist/scripts/verify-browser.js",
    "verify:webui": "pnpm run build && node dist/scripts/verify-webui-design.js",
    "verify:sessions": "pnpm run build && node dist/scripts/verify-session-workspaces.js",
    "verify:live": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify-live.js"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.1",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "openai": "7.18.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  }
}
