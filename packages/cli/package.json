{
  "name": "@fatcat/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Fatcat command-line launcher and terminal chat client.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/run.d.ts",
      "import": "./dist/cli/run.js"
    },
    "./entry": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@fatcat/runtime": "workspace:*",
    "@fatcat/commands": "workspace:*",
    "@fatcat/tui": "workspace:*",
    "@fatcat/webui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  }
}
