{
  "name": "fatcat",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript agent harness for native Windows execution.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node dist/scripts/copy-skills.js && node dist/scripts/copy-webui.js",
    "start": "pnpm run build && node --env-file-if-exists=.env dist/scripts/start.js",
    "test": "pnpm run build && node dist/scripts/test.js",
    "verify:tui": "pnpm run build && node dist/scripts/verify/native/verify-tui.js",
    "verify:cli": "pnpm run build && node dist/scripts/verify/native/verify-cli.js",
    "verify:delegation": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-delegation.js",
    "verify:coding": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-coding.js",
    "verify:workflow": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-workflow.js",
    "verify:context": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-context.js",
    "verify:web": "pnpm run build && node dist/scripts/verify/network/verify-web.js",
    "verify:browser": "pnpm run build && node dist/scripts/verify/browser/verify-browser.js",
    "verify:webui": "pnpm run build && node dist/scripts/verify/browser/verify-webui-design.js",
    "verify:sessions": "pnpm run build && node dist/scripts/verify/browser/verify-session-workspaces.js",
    "verify:projects": "pnpm run build && node dist/scripts/verify/browser/verify-projects.js",
    "verify:project-management": "pnpm run build && node dist/scripts/verify/browser/verify-project-management.js",
    "verify:folder-picker": "pnpm run build && node dist/scripts/verify/native/verify-folder-picker.js",
    "verify:attachments": "pnpm run build && node dist/scripts/verify/browser/verify-attachments.js",
    "verify:documents": "pnpm run build && node dist/scripts/verify/browser/verify-documents.js",
    "verify:memory": "pnpm run build && node dist/scripts/verify/browser/verify-memory.js",
    "verify:memory:live": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-memory-live.js",
    "verify:live": "pnpm run build && node --env-file-if-exists=.env dist/scripts/verify/live/verify-live.js"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.1",
    "@napi-rs/canvas": "1.0.11",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "openai": "7.18.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "saxes": "6.0.0",
    "yaml": "2.9.1"
  }
}
