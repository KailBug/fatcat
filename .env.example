# Copy this file to .env and configure the selected provider's API key locally.
# Do not commit credentials or paste them into chat.
HARNESS_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Kimi Open Platform: cn or global; keys and endpoints must match.
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_REGION=cn

# MiMo pay-as-you-go API, not Token Plan.
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash

# Qwen PAYG: cn/intl support legacy endpoints; us/eu/jp/hk require QWEN_WORKSPACE_ID.
# Set a workspace ID to use its regional maas endpoint. Keys must match that workspace and region.
# QWEN_WORKSPACE_ID=your-workspace-id
# Current alternatives: qwen3.8-max, qwen3.8-flash, qwen3.7-plus.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_REGION=cn


HARNESS_MAX_ITERATIONS=128
HARNESS_REQUEST_TIMEOUT_MS=60000

# Local JSON request-body budget, not a provider token limit.
HARNESS_MAX_REQUEST_BYTES=262144

# Compact older complete turns once after a local request-limit rejection.
# Summary requests share HARNESS_MAX_ITERATIONS with the current turn.
HARNESS_AUTO_COMPACT=true
